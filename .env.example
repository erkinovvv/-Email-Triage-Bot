# =====================================================================
#  AI Email Triage Bot - copy this file to `.env` and fill in the values
# =====================================================================

# ----- Gmail IMAP -----
# Use a Gmail "App Password" (NOT your normal password). Requires 2FA enabled.
# Generate one at: https://myaccount.google.com/apppasswords
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=youraddress@gmail.com
IMAP_PASSWORD=xxxxxxxxxxxxxxxx
IMAP_FOLDER=INBOX

# ----- LLM (Groq, free tier) -----
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# ----- Slack (optional) -----
# Create an Incoming Webhook: https://api.slack.com/messaging/webhooks
# Leave blank to skip Slack notifications.
SLACK_WEBHOOK_URL=

# ----- Notion (optional) -----
# Create an integration at https://www.notion.so/my-integrations
# Then share the target database with the integration.
# Required DB columns:
#   Title (Title), From (Rich text), Classification (Select),
#   Priority (Select), Summary (Rich text),
#   Suggested Action (Rich text), Received (Date)
NOTION_API_TOKEN=
NOTION_DATABASE_ID=

# ----- Behaviour -----
BATCH_LIMIT=25
HTTP_TIMEOUT=30
LLM_MAX_RETRIES=3
LOG_LEVEL=INFO
